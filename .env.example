# Placeholder saja. Jangan isi kredensial asli di file ini; salin ke .env (di-ignore git).
# Proyek Supabase (hanya untuk operator tepercaya, jangan dipakai oleh tes lokal):
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
# Jangan pernah dikirim ke klien:
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Tes lokal sekali pakai (opsional, hanya localhost / 127.0.0.1 / ::1 / path socket):
# SENDFOOD_TEST_PGHOST=127.0.0.1
# SENDFOOD_TEST_PGPORT=5432
# SENDFOOD_TEST_PGUSER=postgres
# PG_BIN=/path/ke/postgres/bin
