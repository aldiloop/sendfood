# Placeholder saja. Jangan isi kredensial asli di file ini; salin ke .env (di-ignore git).

# --- Frontend (boleh publik; tetap dilindungi RLS) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_ME
# Bila memakai Vite/Next, namakan sesuai framework (mis. VITE_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL).

# --- Hanya server/operator tepercaya ---
# service_role key HANYA di sisi server atau lingkungan operator. JANGAN PERNAH di frontend, repo, atau log.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# --- Tes lokal sekali pakai (opsional; hanya localhost / 127.0.0.1 / ::1 / path socket) ---
# Tes lokal tidak memakai kunci Supabase di atas dan tidak menghubungi Supabase cloud.
# PG_BIN=/path/ke/postgres/bin
# STACK_BIN=/path/ke/direktori/biner/gotrue-postgrest   # default .pgtools/svc (lihat tests/stack/fetch_bins.sh)
# SENDFOOD_TEST_PGHOST=127.0.0.1
# SENDFOOD_TEST_PGPORT=5432
# SENDFOOD_TEST_PGUSER=postgres
# SENDFOOD_MIGRATION_ALLOW_DB_PREFIX=sendfood_   # untuk scripts/apply_migration_local.sh
